{
  "name": "@dndd/utils",
  "version": "0.2.0",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@dndd/eslint-config": "workspace:*",
    "@dndd/typescript-config": "workspace:*",
    "@types/node": "^20.10.6",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  }
}
